{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontHackaton/browser",
  "rewrites": [
    {
      "source": "/api/:caminho*",
      "destination": "https://portal-criare-api.onrender.com/api/:caminho*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
