# Copie para .env (que não vai para o git) e preencha. A API lê este arquivo ao subir
# pelo Maven ou pelo docker compose, e as variáveis de ambiente de verdade têm prioridade.

# Chave dos tokens: openssl rand -base64 32
JWT_SECRET=

# Superadmin da plataforma (opcional): os dois juntos, senha com 12 caracteres ou mais
SUPERADMIN_EMAIL=
SUPERADMIN_SENHA=

# Banco (os padrões já batem com o docker-compose.yml)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5435/bdgestao
# SPRING_DATASOURCE_USERNAME=user
# SPRING_DATASOURCE_PASSWORD=coti
